{
  "version": 3,
  "configurePresets": [
    {
      "name": "android-arm64",
      "displayName": "Android ARM64",
      "description": "Build for arm64-v8a with Android NDK",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux Native",
      "description": "Native build for Linux servers (x86_64 or aarch64); uses the host compiler (g++ or clang++)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux"
    }
  ],
  "buildPresets": [
    {
      "name": "android-arm64",
      "configurePreset": "android-arm64"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ]
}
